<?xml version="1.0" encoding="UTF-8"?><xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:doi="http://www.doi.org/2010/DOISchema" xmlns:doiavs="http://www.doi.org/2010/DOISchemaAVS" xmlns:eidr="http://www.eidr.org/schema" xmlns:iso3166a2="http://www.doi.org/2010/iso3166a2" xmlns:md="http://www.movielabs.com/schema/md/v2.8/md" attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="http://www.eidr.org/schema" version="2.7.0-localimport">
  <xs:import namespace="http://www.doi.org/2010/DOISchema" schemaLocation="doi.xsd"/>
  <xs:import namespace="http://www.doi.org/2010/DOISchemaAVS" schemaLocation="doiavs.xsd"/>
  <xs:import namespace="http://www.doi.org/2010/iso3166a2" schemaLocation="iso3166a2.xsd"/>
  <xs:import namespace="http://www.movielabs.com/schema/md/v2.8/md" schemaLocation="md-v28-eidr.xsd"/>
  <xs:annotation>
    <xs:documentation> </xs:documentation>
  </xs:annotation>
  <xs:element name="CreateBasic" type="eidr:createBasicDataType"/>
  <xs:element name="CreateSeries" type="eidr:createSeriesDataType"/>
  <xs:element name="CreateSeason" type="eidr:createSeasonDataType"/>
  <xs:element name="CreateEpisode" type="eidr:createEpisodeDataType"/>
  <xs:element name="CreateComposite" type="eidr:createCompositeDataType"/>
  <xs:element name="CreateCompilation" type="eidr:createCompilationDataType"/>
  <xs:element name="CreateClip" type="eidr:createClipDataType"/>
  <xs:element name="CreateEdit" type="eidr:createEditDataType"/>
  <xs:element name="CreateManifestation" type="eidr:createManifestationDataType"/>
  <xs:element name="ResolvedFullGeneral" type="eidr:fullObjectInfoType"/>
  <xs:element name="ResolvedSelfGeneral" type="eidr:allSelfDefinedInfoType"/>
  <xs:element name="ResolvedInheritedGeneral" type="eidr:allInheritedInfoType"/>
  <xs:element name="SimpleInfo" type="eidr:simpleInfoType"/>
  <!-- self-defined fields -->
  <xs:complexType name="allSelfDefinedInfoType">
    <xs:annotation>
      <xs:documentation> Contains all the fields defined on the object itself. This is the
				return value for a request for resolution of a DOI to its 'own' information.
			</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="BaseObjectData" type="eidr:selfDefinedBaseObjectInfoType"/>
      <xs:element minOccurs="0" name="ExtraObjectMetadata" type="eidr:extraObjectMetadataType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="selfDefinedBaseObjectInfoType">
    <xs:annotation>
      <xs:documentation> This is what you get when you do a resolution for self-defined
				metadata. ID and Administrators must be defined on every object.
				AlternateIDs, RegistrantExtra are never inherited, but can be
				optionally provided. Everything else can come from self or parent, and hence is
				optional here. VersionLanguages are only those defined on the object, rather than
				constructed from a Manifestation </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <!-- ID is required for every object -->
      <xs:element name="ID" type="eidr:assetDOIType"/>
      <xs:group ref="eidr:selfDefinedFieldsGroup"/>
    </xs:sequence>
  </xs:complexType>
  <!-- helper group for self-defined fields -->
  <xs:group name="selfDefinedFieldsGroup">
    <xs:sequence>
      <xs:element minOccurs="0" name="StructuralType" type="doiavs:creationStructuralType"/>
      <xs:element minOccurs="0" name="Mode" type="eidr:modeType"/>
      <xs:element minOccurs="0" name="ReferentType" type="eidr:referentType"/>
      <xs:element minOccurs="0" name="ResourceName" type="eidr:titleType"/>
      <xs:element maxOccurs="128" minOccurs="0" name="AlternateResourceName" type="eidr:titleType"/>
      <xs:element maxOccurs="32" minOccurs="0" name="OriginalLanguage" type="eidr:languageType"/>
      <xs:element maxOccurs="64" minOccurs="0" name="VersionLanguage" type="eidr:languageType"/>
      <xs:element maxOccurs="16" minOccurs="0" name="AssociatedOrg" type="md:AssociatedOrg-type"/>
      <xs:element minOccurs="0" name="ReleaseDate" type="eidr:dateType"/>
      <xs:element maxOccurs="32" minOccurs="0" name="CountryOfOrigin" type="eidr:countryType"/>
      <xs:element minOccurs="0" name="Status" type="eidr:statusType"/>
      <xs:element minOccurs="0" name="ApproximateLength" type="xs:duration"/>
      <xs:element maxOccurs="unbounded" minOccurs="0" name="AlternateID" type="eidr:alternateIDType"/>
      <!-- Administrators must be defined on every object because it contains the registrant -->
      <xs:element name="Administrators" type="eidr:administratorsInfoType"/>
      <xs:element minOccurs="0" name="Credits" type="eidr:creditsType"/>
      <xs:element minOccurs="0" name="RegistrantExtra" type="eidr:registrantExtraDataType"/>
      <xs:element minOccurs="0" name="Description" type="eidr:descriptionType"/>
    </xs:sequence>
  </xs:group>
  <!-- inherited fields -->
  <xs:complexType name="allInheritedInfoType">
    <xs:annotation>
      <xs:documentation> This includes fields that are inherited. No data in
				ExtraObjectMetadata is ever inherited. This is the return value for a request to
				resolve a DOI to its inherited values. See API overview for languages and titles.
				Alternate IDs and RegistrantExtra are never inherited. </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="BaseObjectData" type="eidr:inheritedBaseObjectInfoType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="inheritedBaseObjectInfoType">
    <xs:annotation>
      <xs:documentation> ID, Administrators, AlternateIDs, and
				Description can never be inherited. ResourceName and AlternateResourceName are never
				inherited for Seasons or Episodes. Everything else can be, but doesn't have to be.
			</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="ID" type="eidr:assetDOIType"/>
      <xs:group ref="eidr:inheritedBaseObjectInfoGroup"/>
    </xs:sequence>
  </xs:complexType>
  <xs:group name="inheritedBaseObjectInfoGroup">
    <xs:sequence>
      <xs:element minOccurs="0" name="StructuralType" type="doiavs:creationStructuralType"/>
      <xs:element minOccurs="0" name="Mode" type="eidr:modeType"/>
      <xs:element minOccurs="0" name="ReferentType" type="eidr:referentType"/>
      <xs:element minOccurs="0" name="ResourceName" type="eidr:titleType"/>
      <xs:element maxOccurs="128" minOccurs="0" name="AlternateResourceName" type="eidr:titleType"/>
      <xs:element maxOccurs="32" minOccurs="0" name="OriginalLanguage" type="eidr:languageType"/>
      <xs:element maxOccurs="64" minOccurs="0" name="VersionLanguage" type="eidr:languageType"/>
      <xs:element maxOccurs="16" minOccurs="0" name="AssociatedOrg" type="md:AssociatedOrg-type"/>
      <xs:element minOccurs="0" name="ReleaseDate" type="eidr:dateType"/>
      <xs:element maxOccurs="32" minOccurs="0" name="CountryOfOrigin" type="eidr:countryType"/>
      <xs:element minOccurs="0" name="Status" type="eidr:statusType"/>
      <xs:element minOccurs="0" name="ApproximateLength" type="xs:duration"/>
      <!-- AlternateIDs are never inherited -->
      <!-- <xs:element name="AlternateID" type="eidr:alternateIDType" minOccurs="0" maxOccurs="0"/> -->
      <!-- Administrators isn't inherited because it contains the registrant -->
      <!-- <xs:element minOccurs="0" maxOccurs="0" name="Administrators" type="eidr:administratorsInfoType" /> -->
      <xs:element minOccurs="0" name="Credits" type="eidr:creditsType"/>
      <!-- RegistrantExtra and Descriptions are never inherited -->
      <!-- <xs:element name="RegistrantExtra" type="eidr:registrantExtraDataType" minOccurs="0" /> -->
      <!-- <xs:element name="Description" type="eidr:descriptionType" minOccurs="0" maxOccurs="0"/> -->
    </xs:sequence>
  </xs:group>
  <!-- tiny information returned by queries and traversals -->
  <xs:complexType name="simpleInfoType">
    <xs:sequence>
      <xs:annotation>
        <xs:documentation> This is returned by queries and traversals. </xs:documentation>
      </xs:annotation>
      <xs:element name="ID" type="eidr:assetDOIType"/>
      <xs:element name="StructuralType" type="doiavs:creationStructuralType"/>
      <xs:element name="ReferentType" type="eidr:referentType"/>
      <xs:element name="ResourceName" type="eidr:titleType"/>
      <xs:element maxOccurs="32" name="OriginalLanguage" type="eidr:languageType"/>
      <xs:element maxOccurs="64" minOccurs="0" name="VersionLanguage" type="eidr:languageType"/>
      <xs:element name="ReleaseDate" type="eidr:dateType"/>
      <xs:element name="Status" type="eidr:statusType"/>
      <xs:element maxOccurs="unbounded" minOccurs="0" name="Relationship" type="eidr:relationshipInfoType"/>
    </xs:sequence>
  </xs:complexType>
  <!-- alternate IDs only -->
  <xs:complexType name="alternateIDsType">
    <xs:annotation>
      <xs:documentation> An asset's AlternateIDs only. </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="ID" type="eidr:assetDOIType"/>
      <xs:element maxOccurs="unbounded" minOccurs="0" name="AlternateID" type="eidr:alternateIDType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="linkedAlternateIDsType">
    <xs:annotation>
      <xs:documentation> An asset's AlternateIDs and associated URLs. </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="ID" type="eidr:assetDOIType"/>
      <xs:element maxOccurs="unbounded" minOccurs="0" name="LinkedAlternateID" type="eidr:linkedAlternateIDType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="linkedAlternateIDType">
    <xs:annotation>
      <xs:documentation> An AlternateID together with 0 or more URL elements. </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="AlternateID" type="eidr:alternateIDType"/>
      <xs:element maxOccurs="unbounded" minOccurs="0" name="URL" type="eidr:linkedAlternateIDURLType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="linkedAlternateIDURLType">
    <xs:simpleContent>
      <xs:extension base="xs:anyURI">
        <xs:attribute name="type" type="xs:string"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <!-- complete fields, combined from inherited and self-defined -->
  <xs:complexType name="fullObjectInfoType">
    <xs:annotation>
      <xs:documentation> This contains all the information about the object. This is the
				return value for a request for full resolution of an asset DOI. In baseObjectData
				all mandatory fields are provided (either by inheritance or actual presence.) The
				languages fields are fuly realized, based on the inheritance, add, and replace chain
				from all ancestors. ExtraObjectmetadata contains metadata for any described type
				information or relationships or relationships that are present. (See
				extraObjectMetadataType for the legal combinations.) </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="BaseObjectData" type="eidr:baseObjectInfoType"/>
      <xs:element minOccurs="0" name="ExtraObjectMetadata" type="eidr:extraObjectMetadataType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="baseObjectInfoType">
    <xs:sequence>
      <xs:annotation>
        <xs:documentation> This contains all the base metadata that could be on the object,
					inherited, self-defined, or generated. </xs:documentation>
      </xs:annotation>
      <xs:element name="ID" type="eidr:assetDOIType"/>
      <xs:group ref="eidr:baseObjectInfoGroup"/>
    </xs:sequence>
  </xs:complexType>
  <xs:group name="baseObjectInfoGroup">
    <xs:sequence>
      <xs:element name="StructuralType" type="doiavs:creationStructuralType"/>
      <xs:element name="Mode" type="eidr:modeType"/>
      <xs:element name="ReferentType" type="eidr:referentType"/>
      <xs:element name="ResourceName" type="eidr:titleType"/>
      <xs:element maxOccurs="128" minOccurs="0" name="AlternateResourceName" type="eidr:titleType"/>
      <xs:element maxOccurs="32" name="OriginalLanguage" type="eidr:languageType"/>
      <xs:element maxOccurs="64" minOccurs="0" name="VersionLanguage" type="eidr:languageType"/>
      <xs:element maxOccurs="16" minOccurs="0" name="AssociatedOrg" type="md:AssociatedOrg-type"/>
      <xs:element name="ReleaseDate" type="eidr:dateType"/>
      <xs:element maxOccurs="32" name="CountryOfOrigin" type="eidr:countryType"/>
      <xs:element name="Status" type="eidr:statusType"/>
      <xs:element name="ApproximateLength" type="xs:duration"/>
      <xs:element maxOccurs="unbounded" minOccurs="0" name="AlternateID" type="eidr:alternateIDType"/>
      <xs:element name="Administrators" type="eidr:administratorsInfoType"/>
      <xs:element minOccurs="0" name="Credits" type="eidr:creditsType"/>
      <xs:element minOccurs="0" name="RegistrantExtra" type="eidr:registrantExtraDataType"/>
      <xs:element minOccurs="0" name="Description" type="eidr:descriptionType"/>
    </xs:sequence>
  </xs:group>
  <xs:complexType name="extraObjectMetadataType">
    <xs:annotation>
      <xs:documentation> Metadata for child objects and derived objects. This schema enforces
				the following rules for what extra metadata can be present ((0 or 1 of compilation,
				season, series, interactive material, episode, episode+composite, or composite) OR
				(0 or 1 of Edit,Manifestation, or Clip)) AND (0 or more of each of Promotion,
				Supplement, AlternateContent, Packaging) </xs:documentation>
    </xs:annotation>
    <xs:sequence minOccurs="0">
      <xs:choice>
        <!-- 0-1 of compilation season, series, interactive material, episode, episode+composite, or composite -->
        <xs:choice minOccurs="0">
          <xs:element name="CompilationInfo" type="md:CompObj-type"/>
          <xs:element name="SeasonInfo" type="eidr:seasonInfoType"/>
          <xs:element name="SeriesInfo" type="eidr:seriesInfoType"/>
          <xs:element name="InteractiveMaterialInfo" type="md:DigitalAssetInteractiveBaseData-type"/>
          <xs:sequence>
            <xs:element name="EpisodeInfo" type="eidr:episodeInfoType"/>
            <xs:element minOccurs="0" name="CompositeInfo" type="eidr:compositeInfoType"/>
          </xs:sequence>
          <xs:element name="CompositeInfo" type="eidr:compositeInfoType"/>
        </xs:choice>
        <!-- OR (0 or 1 of Edit, Manifestation, Clip) -->
        <xs:sequence minOccurs="0">
          <xs:choice minOccurs="0">
            <xs:element name="EditInfo" type="eidr:editInfoType"/>
            <xs:element name="ManifestationInfo" type="eidr:manifestationInfoType"/>
            <xs:element name="ClipInfo" type="eidr:clipInfoType"/>
          </xs:choice>
        </xs:sequence>
      </xs:choice>
      <!-- AND (0 or more of promotion, supplementalContent, alternateContent, packaging -->
      <xs:element maxOccurs="unbounded" minOccurs="0" name="PromotionInfo" type="eidr:promotionInfoType"/>
      <xs:element maxOccurs="unbounded" minOccurs="0" name="SupplementalContentInfo" type="eidr:supplementalContentInfoType"/>
      <xs:element maxOccurs="unbounded" minOccurs="0" name="AlternateContentInfo" type="eidr:alternateContentInfoType"/>
      <xs:element maxOccurs="unbounded" minOccurs="0" name="PackagingInfo" type="eidr:packagingInfoType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="provenanceInfoType">
    <xs:annotation>
      <xs:documentation>Returned by provenance resolution</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="ID" type="eidr:assetDOIType"/>
      <xs:element name="IssueNumber" type="xs:integer"/>
      <xs:element name="Status" type="eidr:statusType"/>
      <xs:element name="Administrators" type="eidr:administratorsInfoType"/>
      <xs:element minOccurs="0" name="CreatedBy" type="eidr:userDOIType"/>
      <xs:element name="CreationDate" type="xs:dateTime"/>
      <xs:element minOccurs="0" name="LastModifiedBy" type="eidr:userDOIType"/>
      <xs:element name="LastModificationDate" type="xs:dateTime"/>
      <xs:element minOccurs="0" name="PublicationDate" type="xs:dateTime"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="administratorsInfoType">
    <xs:annotation>
      <xs:documentation> Used in provenanceInfoType, baseObjectInfoType, and
				selfDefinedBaseObjectInfoType </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Registrant" type="eidr:registrantType"/>
      <xs:element maxOccurs="4" minOccurs="0" name="MetadataAuthority" type="eidr:metadataAuthorityType"/>
    </xs:sequence>
  </xs:complexType>
  <!-- Series, Season, Episode -->
  <xs:complexType name="seriesInfoType">
    <xs:annotation>
      <xs:documentation> Series must supply base object ReferentType, StructuralType,
				OriginalLanguage, and ReleaseDate. baseObjectData.ApproximateLength must be 0 (zero)
				or the typical length of an episode </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" name="EndDate" type="eidr:dateType"/>
      <xs:element minOccurs="0" name="SeriesClass" type="eidr:seriesClassType"/>
      <xs:element minOccurs="0" name="NumberRequired" type="xs:boolean"/>
      <xs:element minOccurs="0" name="DateRequired" type="xs:boolean"/>
      <xs:element minOccurs="0" name="OriginalTitleRequired" type="xs:boolean"/>
    </xs:sequence>
  </xs:complexType>
  <xs:simpleType name="seriesClassType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Episodic"/>
      <xs:enumeration value="Anthology"/>
      <xs:enumeration value="LimitedSeries"/>
      <xs:enumeration value="Mini-series"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="seasonInfoType">
    <xs:annotation>
      <xs:documentation> Season must supply base object ReferentType, StructuralType, and
				ReleaseDate. baseObjectData.ApproximateLength must be 0 (zero) the typical length of
				an episode.
				baseObjectData.ResourceName is used to provide a season title and is required, but
				may be submitted empty or replaced with a system-generated name under special
				circumstances. </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Parent" type="eidr:assetDOIType"/>
      <xs:element minOccurs="0" name="EndDate" type="eidr:dateType"/>
      <xs:element maxOccurs="unbounded" minOccurs="0" name="SeasonClass" type="eidr:seasonClassType"/>
      <xs:element minOccurs="0" name="NumberRequired" type="xs:boolean"/>
      <xs:element minOccurs="0" name="DateRequired" type="xs:boolean"/>
      <xs:element minOccurs="0" name="OriginalTitleRequired" type="xs:boolean"/>
      <xs:element minOccurs="0" name="SequenceNumber" type="xs:positiveInteger"/>
    </xs:sequence>
  </xs:complexType>
  <xs:simpleType name="seasonClassType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Adjunct"/>
      <xs:enumeration value="Enhanced"/>
      <xs:enumeration value="LimitedSeries"/>
      <xs:enumeration value="Main"/>
      <xs:enumeration value="Mini-series"/>
      <xs:enumeration value="Pro Forma"/>
      <xs:enumeration value="Recut"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="episodeInfoType">
    <xs:annotation>
      <xs:documentation> Episode must supply base object, ReferentType, StructuralType,
				ReleaseDate. If Episode is a child of a Season, it inherits the Season's TimeSlot.
				baseObjectData.ApproximateLength is used for the length of the episode
				baseObjectData.ResourceName is used to provide an episode title and is required, but
				may be submitted empty or replaced with a system-generated name under special
				circumstances. </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Parent" type="eidr:assetDOIType"/>
      <xs:element minOccurs="0" name="SequenceInfo" type="md:ContentSequenceInfo-type"/>
      <xs:element maxOccurs="unbounded" minOccurs="0" name="EpisodeClass" type="eidr:episodeClassType"/>
      <!-- TimeSlot must specify UTC or a time zone -->
      <xs:element minOccurs="0" name="TimeSlot" type="xs:time"/>
    </xs:sequence>
  </xs:complexType>
  <xs:simpleType name="episodeClassType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Main"/>
      <xs:enumeration value="Pilot"/>
      <xs:enumeration value="Standalone"/>
      <xs:enumeration value="Special"/>
      <xs:enumeration value="Omnibus"/>
      <xs:enumeration value="Recut"/>
      <xs:enumeration value="Segment"/>
    </xs:restriction>
  </xs:simpleType>
  <!-- End of Series, Season, Episode -->
  <!-- Composites -->
  <xs:complexType name="compositeInfoType">
    <xs:sequence>
      <xs:element name="CompositeClass" type="eidr:compositeClassType"/>
      <xs:element maxOccurs="unbounded" minOccurs="0" name="Element" type="eidr:compositeElementType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:simpleType name="compositeClassType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Mashup"/>
      <xs:enumeration value="Omnibus"/>
      <xs:enumeration value="Excerpt"/>
      <xs:enumeration value="Inclusion"/>
      <xs:enumeration value="Other"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="compositeElementType">
    <xs:sequence>
      <xs:choice>
        <xs:element name="ID" type="eidr:assetDOIType"/>
        <xs:element name="OtherID" type="eidr:alternateIDType"/>
      </xs:choice>
      <!-- starting point of this element within its source -->
      <xs:element minOccurs="0" name="SourceStart" type="eidr:startingPointType"/>
      <!-- duration of this element within its source -->
      <xs:element minOccurs="0" name="SourceDuration" type="xs:duration"/>
      <xs:element minOccurs="0" name="ComponentsMode" type="eidr:componentsModeType"/>
      <!-- where this element occurs in the composite -->
      <xs:element minOccurs="0" name="DestStart" type="eidr:startingPointType"/>
      <!-- how long this element lasts within the composite -->
      <xs:element minOccurs="0" name="DestDuration" type="xs:duration"/>
      <xs:element minOccurs="0" name="Description" type="eidr:string128Type"/>
    </xs:sequence>
  </xs:complexType>
  <xs:simpleType name="startingPointType">
    <xs:annotation>
      <xs:documentation> This is for defining where something starts in a Composite or Clip.
				It is a duration rather than a time to to make doing math on starts and durations a
				little easier. It can be viewed as 'the duration from the start of the thing in
				question after which something happens.' </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:duration"/>
  </xs:simpleType>
  <!-- End of Composites -->
  <!-- Compilation -->
  <!-- all taken from md: and redefinitions -->
  <!-- end of Compilation -->
  <!-- Edits, Clips -->
  <xs:complexType name="editInfoType">
    <xs:annotation>
      <xs:documentation> An edit must provide, rather than inherit, Description,
				ApproximateLength, and ReleaseDate on baseRegistrationData. </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Parent" type="eidr:assetDOIType"/>
      <xs:element name="EditUse" type="eidr:editUseType"/>
      <xs:element maxOccurs="8" minOccurs="0" name="EditClass" type="eidr:editClassType"/>
      <xs:element maxOccurs="8" minOccurs="0" name="MadeForRegion" type="eidr:madeForRegionType"/>
      <xs:element maxOccurs="8" minOccurs="0" name="EditDetails" type="eidr:usageDetailsType"/>
      <xs:element name="ColorType" type="md:ColorType-type"/>
      <xs:element name="ThreeD" type="xs:boolean"/>
    </xs:sequence>
  </xs:complexType>
  <xs:simpleType name="editUseType">
    <xs:annotation>
      <xs:documentation> These are intended to capture the original, primary, intended use for
				the Edit. In many cases, the actual uses will be different, e.g., iTunes using the
				Theatrical cut. </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="Airline"/>
      <xs:enumeration value="Broadcast"/>
      <xs:enumeration value="Home Video"/>
      <xs:enumeration value="Hospitality"/>
      <xs:enumeration value="Multiuse"/>
      <xs:enumeration value="Preservation Master"/>
      <xs:enumeration value="Streaming"/>
      <xs:enumeration value="Theatrical"/>
      <xs:enumeration value="Web"/>
      <xs:enumeration value="Unknown"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="editClassType">
    <xs:annotation>
      <xs:documentation> These are intended to enumerate the primary, distinguishing
				characteristics of the Edit. </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="Alternate Ending"/>
      <xs:enumeration value="Anniversary"/>
      <xs:enumeration value="Censored"/>
      <xs:enumeration value="Colorized"/>
      <xs:enumeration value="Content Break"/>
      <xs:enumeration value="Creative"/>
