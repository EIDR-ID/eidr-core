  <xs:simpleType name="string-SequenceInfo-DistributionNumber">
    <xs:restriction base="xs:string">
      <xs:annotation>
        <xs:documentation>
                        String starting with one or more digits 1-9, followed by zero or more alphanumeric characters;
                        optionally followed by a suffix composed of a separator character followed by 1 or more alphanumeric characters.
                        Allowed separators are :/-.,
                        NOTE: this must be the same as string-Compilation-EntryNumber (q.v.)
                    </xs:documentation>
      </xs:annotation>
      <xs:maxLength value="8"/>
      <xs:pattern value="0|[1-9][0-9a-zA-Z]*([:/\-.,][0-9a-zA-Z]+)?"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="string-SequenceInfo-DistributionNumber-domain">
    <xs:restriction base="xs:string">
      <xs:annotation>
        <xs:documentation>
                        2-256 characters
                        any number of non-whitespace characters, then a ., then any number of non-whitespace characters
                        Not perfect, but will catch some common cases, particularly (present but empty), (all blanks) and  (no '.' character)
                    </xs:documentation>
      </xs:annotation>
      <xs:minLength value="4"/>
      <xs:maxLength value="256"/>
      <xs:pattern value="[\S]+[.][\S]+"/>
    </xs:restriction>
  </xs:simpleType>
