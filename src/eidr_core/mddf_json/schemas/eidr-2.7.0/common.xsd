      <xs:enumeration value="CreateSeries"/>
      <xs:enumeration value="CreateManifestation"/>
      <xs:enumeration value="CreateEdit"/>
      <xs:enumeration value="CreateClip"/>
      <xs:enumeration value="CreateComposite"/>
