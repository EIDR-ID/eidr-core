  <xs:simpleType name="administratorTypeType">
    <xs:annotation>
      <xs:documentation>See Chapter 7 of the spec for details on these.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="AssociatedOrg">
        <xs:annotation>
          <xs:documentation>Identifies a party that can be listed as an AssociatedOrg for
						an asset.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Registrant">
        <xs:annotation>
          <xs:documentation>Identifies a party that is registering or has registered a
						work</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MetadataAuthority">
        <xs:annotation>
          <xs:documentation>Identifies a party who has asserted that they possess complete
						and correct metadata for the record and who has agreed to maintain the
						record.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="EncodingAgent">
        <xs:annotation>
          <xs:documentation>Identifies a partythat can be listed as EncodingAgent for a
						regustered encoding</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Writer">
        <xs:annotation>
          <xs:documentation>Identifies a party that can write to objects, but not create,
						delete, or promote them -- e.g. a clean-up crew</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Reader">
        <xs:annotation>
          <xs:documentation>Identifies a party that is allowed to see information that
						would otherwise be hidden</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ServiceAdmin">
        <xs:annotation>
          <xs:documentation>Identifies a party that is allowed to create, modify, delete,
						or alias video services information</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AltIDWriter">
        <xs:annotation>
          <xs:documentation>Identifies a party that is allowed to modify
						AlternateID information on any record</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
