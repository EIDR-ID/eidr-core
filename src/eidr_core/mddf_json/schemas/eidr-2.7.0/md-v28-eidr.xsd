                    </xs:documentation>
      </xs:annotation>
      <xs:maxLength value="8"/>
      <xs:pattern value="[0-9a-zA-Z:/\-.,]+"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="string-SequenceInfo-HouseSequence-domain">
    <xs:restriction base="xs:string">
      <xs:annotation>
        <xs:documentation>
                        2-256 characters
                        any number of non-whitespace characters, then a ., then any number of non-whitespace characters
                        Not perfect, but will catch some common cases, particularly (present but empty), (all blanks) and  (no '.' character)
                    </xs:documentation>
      </xs:annotation>
      <xs:minLength value="4"/>
      <xs:maxLength value="256"/>
      <xs:pattern value="[\S]+[.][\S]+"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="complex-SequenceInfo-AlternateNumber">
    <xs:annotation>
      <xs:documentation>
                            domain attribute is required for AlternateNumber
                        </xs:documentation>
    </xs:annotation>
