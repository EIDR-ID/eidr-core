  <xs:complexType name="baseAssetDOIType">
    <xs:simpleContent>
      <xs:extension base="xs:string"/>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="assetDOIType">
    <xs:annotation>
      <xs:documentation>
				other files use redefine with eidr-base.xsd and redefine assetDOIType
				see assetDOIType.xsd for the canonical forms
			</xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:restriction base="eidr:baseAssetDOIType">
        <xs:annotation>
          <xs:documentation>
							Restrict assetDOIType to be only proper DOIs, stripping out the special bulk ingestion pattern
						</xs:documentation>
        </xs:annotation>
        <xs:pattern value="10\.5240/[\dA-F]{4}-[\dA-F]{4}-[\dA-F]{4}-[\dA-F]{4}-[\dA-F]{4}-[\dA-Z]"/>
        <xs:pattern value="10\.5240/[\dA-F]{20}[\dA-Z]"/>
        <!-- uncomment to allow non-DOI handle prefixes -->
        <!-- <xs:pattern value="[^/]+/[\dA-F]{4}-[\dA-F]{4}-[\dA-F]{4}-[\dA-F]{4}-[\dA-F]{4}-[\dA-Z]"/> -->
        <!-- <xs:pattern value="[^/]+/[\dA-F]{20}[\dA-Z]"/> -->
      </xs:restriction>
    </xs:simpleContent>
  </xs:complexType>
</xs:schema>
