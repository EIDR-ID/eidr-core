  <xs:element name="Resolutions" type="eidr:resolutionSetType"/>
  <xs:complexType name="resolutionSetType">
    <xs:annotation>
      <xs:documentation>
        				This is used by the SDK and atomic tools to return a set of resolutions as a valid piece of XML; the Registry only supports doing resolutions
				one at a time, and all of the results are put in a Resolutions element of this type.
				Most of the tools will generate only a single kind of Resolution at a time.  As of 1.2.1, GraphTool and ResolveTool are the only exceptions to this.
				If the "singleType" attribute is present, it contains the name of the single type of resolution contained by
        <Resolutions/>
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:choice maxOccurs="unbounded" minOccurs="0">
        <xs:element name="SimpleMetadata" type="eidr:simpleInfoType"/>
        <xs:element name="SelfDefinedMetadata" type="eidr:allSelfDefinedInfoType"/>
        <xs:element name="InheritedMetadata" type="eidr:allInheritedInfoType"/>
        <xs:element name="FullMetadata" type="eidr:fullObjectInfoType"/>
        <xs:element name="ProvenanceMetadata" type="eidr:provenanceInfoType"/>
        <xs:element name="kernelMetadata" type="doi:kernelMetadata"/>
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="singleType" type="eidr:resolutionTypeType" use="optional"/>
  </xs:complexType>
  <xs:simpleType name="resolutionTypeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="DOIKernel"/>
      <xs:enumeration value="Full"/>
      <xs:enumeration value="SelfDefined"/>
      <xs:enumeration value="Simple"/>
      <xs:enumeration value="Provenance"/>
      <xs:enumeration value="Inherited"/>
    </xs:restriction>
