  <xs:annotation>
    <xs:documentation> Username and PartyAccountName are properly formatted for use after the
			DOI prefix in userDOIType and partyDOIType. Generally, prefix/username and
			prefix/partyaccountname are referred to as IDs, rather than names. </xs:documentation>
  </xs:annotation>
  <!-- is there any way to define the user and party name patterns, and re-use them in the DOI types wihtout having ot resort to cut and paste? -->
  <xs:element name="PartyAccountName" type="eidr:partyAccountNameType"/>
  <xs:element name="Username" type="eidr:usernameType"/>
  <xs:simpleType name="partyAccountNameType">
    <xs:annotation>
      <xs:documentation> Used when creating accounts. This needs to match the suffix part of
				partyDOIType. </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9a-zA-Z_# \.\-\(\)]{2,64}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="partyDOIType">
    <xs:annotation>
      <xs:documentation> Used for associated orgs, encoding agents, administrative parties,
				prefix is 10.5237 suffix is XXXX-XXXX or 'superparty' </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="10\.5237/[0-9a-fA-F]{4}-[0-9a-fA-F]{4}"/>
      <xs:pattern value="10\.5237/superparty"/>
      <!-- uncomment to allow non-DOI handle prefixes -->
      <!-- <xs:pattern value="[^/]+/[0-9a-fA-F]{4}-[0-9a-fA-F]{4}"/> -->
      <!-- <xs:pattern value="[^/]+/superparty"/> -->
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="usernameType">
    <xs:annotation>
      <xs:documentation> Used when creating accounts. This needs to match the suffix part of
				userDOIType. </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9a-zA-Z_#\.\-\(\)]{3,32}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="userDOIType">
    <xs:annotation>
      <xs:documentation> Used for individuals who have done things, requested things, etc
				prefix is 10.5238 suffix is 3-32 characters from 0-9 a-z A-Z _ # . - ( )
			</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="10\.5238/[0-9a-zA-Z_#\.\-\(\)]{3,32}"/>
      <!-- uncomment to allow non-DOI handle prefixes -->
      <!-- <xs:pattern value="[^/]+/[0-9a-zA-Z_#\.\-\(\)]{3,32}"/> -->
    </xs:restriction>
  </xs:simpleType>
  <xs:group name="partyGroup">
    <xs:annotation>
      <xs:documentation> Describes a Party that is mentioned in the system. Currently uses
				Common Metadata components to avoid defining yet another form of party identifier.
