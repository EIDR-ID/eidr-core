      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:simpleType name="string-SequenceInfo-AlternateNumber">
    <xs:restriction base="xs:string">
      <xs:annotation>
        <xs:documentation>
                        String starting with one or more alphanumeric characters;
                        optionally followed by 0 or more suffixes each composed of a separator character followed by 1 or more alphanumeric characters.
                        Allowed separators are :/-.,
                    </xs:documentation>
      </xs:annotation>
      <xs:maxLength value="8"/>
      <xs:pattern value="[0-9a-zA-Z]+([:/\-.,][0-9a-zA-Z]+)*"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="string-SequenceInfo-AlternateNumber-domain">
    <xs:restriction base="xs:string">
