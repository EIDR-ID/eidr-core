  <xs:complexType name="relationshipsInfoType">
    <xs:sequence>
      <xs:element maxOccurs="unbounded" minOccurs="0" name="Relationship" type="eidr:relationshipInfoType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="relationshipInfoType">
    <xs:annotation>
      <xs:documentation>
         a relationship is described with "
        <Relationship type="eidr:isSeasonOf">assetDOI</Relationship>
        " isCompositeOf and isCompilation
				of can occur multiple times in a relationship list (see SimpleMetadata), once for
				each item in the composite. The lightweight relationships ca occur multiple times.
				Other relationships occur once on any given object.
      </xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="eidr:assetDOIType">
        <xs:attribute name="type" type="eidr:relationshipType" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:simpleType name="relationshipType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="isSeasonOf"/>
      <xs:enumeration value="isEpisodeOf"/>
      <xs:enumeration value="isEditOf"/>
      <xs:enumeration value="isManifestationOf"/>
      <xs:enumeration value="isClipOf"/>
      <xs:enumeration value="isCompositeOf"/>
      <xs:enumeration value="isCompilationOf"/>
      <xs:enumeration value="isPackagingOf"/>
      <xs:enumeration value="isPromotionFor"/>
      <xs:enumeration value="isSupplementTo"/>
      <xs:enumeration value="isAlternateContentFor"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="dateType">
    <xs:annotation>
      <xs:documentation>allows YYYY or YYYY-MM-DD</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="xs:gYear xs:date"/>
  </xs:simpleType>
  <xs:simpleType name="string64Type">
    <xs:restriction base="xs:string">
