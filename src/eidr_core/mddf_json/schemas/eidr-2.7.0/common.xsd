      <xs:enumeration value="Audio"/>
      <xs:enumeration value="Visual"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="modeType">
    <xs:annotation>
      <xs:documentation> use DOI types where possible; use Other for InteractiveMaterial;
				AudioVisual is included for compatibility with DOI 2004 modes</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <!-- flatten-union: enums taken from 'doiModeRestricted' -->
